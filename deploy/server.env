# /etc/hardpoint/server.env -- edit, then: sudo systemctl restart hardpoint
# Game port (UDP). The account port (TCP) is always this + 1.
GAME_PORT=25575
# Extra server options: --team-size=N (1-6) --min-players=N --no-bots --mode=beacons|deathmatch
#   --map=res://resources/maps/<Name>.tres --lobby-idle=<seconds before a match starts without unready players>
SERVER_OPTS=--team-size=5 --min-players=1
