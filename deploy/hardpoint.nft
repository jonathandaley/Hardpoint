#!/usr/sbin/nft -f
# Hardpoint flood limits (T402). Its own table: it only DROPS excess traffic to the two
# game ports and never touches anything else on this machine. Loaded by
# hardpoint-firewall.service. Ports must match /etc/hardpoint/server.env.
#
# IMPORTANT: these limits (and the game's own per-address limits) count per SOURCE
# ADDRESS. If the router in front of this machine rewrites the source address of
# forwarded connections (masquerade / SNAT), every player looks like one address and
# will hit them together. See deploy/README.md "Check the port forward".

table inet hardpoint
delete table inet hardpoint

table inet hardpoint {
	set game_new {
		type ipv4_addr
		flags dynamic,timeout
		timeout 1m
		size 65536
	}
	set acct_new {
		type ipv4_addr
		flags dynamic,timeout
		timeout 1m
		size 65536
	}

	chain input {
		type filter hook input priority filter - 5; policy accept;

		# game port: a new connection attempt is the expensive packet (ENet gives it a slot).
		# One address: 10 new a second (a LAN party behind one router joins in a burst);
		# everyone together: 200 a second, so spoofed sources cannot fill the 1024 slots fast.
		udp dport 25574 ct state new add @game_new { ip saddr limit rate over 10/second burst 20 packets } drop
		udp dport 25574 ct state new limit rate over 200/second burst 400 packets drop

		# account port: the game allows 60 requests a minute per address; one request = one connection
		tcp dport 25575 ct state new add @acct_new { ip saddr limit rate over 90/minute burst 30 packets } drop
		tcp dport 25575 ct state new limit rate over 100/second burst 200 packets drop
	}
}
